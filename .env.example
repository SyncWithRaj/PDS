# ==============================================================================
# NirmanAI Environment Configuration
# ==============================================================================

# Google Gemini API Key (Get yours free at https://aistudio.google.com/)
GEMINI_API_KEY=

# Optional Multi-Key Rotation Pool (Comma-separated list to bypass rate limits)
# When provided, NirmanAI will automatically cycle across keys on HTTP 429:
# GEMINI_API_KEYS=AIzaSyA...,AIzaSyB...,AIzaSyC...

# Default Gemini Model
GEMINI_MODEL=gemini-2.5-flash

# Local Model / GPU Configuration (Optional)
LOCAL_MODEL_PATH=models/pilot_1k
LOCAL_BASE_MODEL=Qwen/Qwen2.5-7B-Instruct

# Local Ollama Fallback (Optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# System Output Directory for Dossiers & HTML Diagrams
NIRMAN_OUTPUT_DIR=output
