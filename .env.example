# ==============================================================================
# NirmanAI Environment Configuration
# ==============================================================================

# Google Gemini Free Tier API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=

# Default Model Selection
GEMINI_MODEL=gemini-1.5-flash

# Local Ollama Fallback (Optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# System Output Directory
NIRMAN_OUTPUT_DIR=output
